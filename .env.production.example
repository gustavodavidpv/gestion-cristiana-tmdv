# ===========================================
# Variables de Entorno - PRODUCCIÓN (Render.com)
# ===========================================
# Estas variables se configuran en el Dashboard de Render,
# NO en un archivo. Este archivo es solo de referencia.
# ===========================================

# Motor por defecto: SQL Server (DB_DIALECT vacía = mssql)
MSSQL_CONNECTION_STRING=workstation id=xxx.mssql.somee.com;user id=usuario;pwd=password;data source=xxx.mssql.somee.com;initial catalog=xxx;TrustServerCertificate=True
# Para volver a PostgreSQL: DB_DIALECT=postgres + DATABASE_URL
# Render provee DATABASE_URL automáticamente al vincular la BD
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Entorno
NODE_ENV=production
PORT=10000

# JWT - Usar un secreto fuerte (Render puede auto-generarlo)
JWT_SECRET=cambiar_por_clave_segura_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h
