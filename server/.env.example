# ===========================================
# Gestión Cristiana - TMDV
# Variables de Entorno - DESARROLLO LOCAL
# ===========================================
# Copia este archivo como .env y modifica los valores
# cp .env.example .env
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database (solo si DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_cristiana_tmdv
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres

# Para producción, usar DATABASE_URL en vez de las variables individuales:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===========================================
# Motor de base de datos: mssql (por defecto, también si está vacía) o postgres
# ===========================================
# DB_DIALECT=mssql
# Para usar PostgreSQL (DATABASE_URL o las variables DB_* de arriba):
# DB_DIALECT=postgres
#
# SQL Server (ej: Somee). DATABASE_URL se ignora en este modo.
# Opción A: la cadena de conexión tal como la entrega Somee
# MSSQL_CONNECTION_STRING=workstation id=xxx.mssql.somee.com;packet size=4096;user id=usuario;pwd=password;data source=xxx.mssql.somee.com;persist security info=False;initial catalog=xxx;TrustServerCertificate=True
# Opción B: variables individuales DB_HOST, DB_PORT=1433, DB_NAME, DB_USER, DB_PASSWORD
#
# DB_SCHEMA=tmv                       # schema de las tablas (por defecto "tmv" en SQL Server)
# DB_ENCRYPT=true                     # cifrar la conexión (por defecto true)
# DB_TRUST_SERVER_CERTIFICATE=true    # aceptar certificado auto-firmado (por defecto true)

# JWT
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# File Uploads
# En desarrollo: ruta local (default: ./public/uploads)
# En produccion (Render Disk): /var/data/uploads
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760

# Client URL (CORS - solo para desarrollo)
CLIENT_URL=http://localhost:3000

# ===========================================
# WhatsApp Business Cloud API (Meta)
# ===========================================
# Para enviar recordatorios automáticos a miembros asignados a roles de culto.
# Obtener en: https://developers.facebook.com/apps/
#
# WHATSAPP_TOKEN: Token de acceso permanente de la app de Meta
# WHATSAPP_PHONE_NUMBER_ID: ID del número de teléfono de WhatsApp Business
# WHATSAPP_TEMPLATE_NAME: Nombre del template aprobado en Meta (default: culto_recordatorio)
# WHATSAPP_TEMPLATE_LANG: Código de idioma del template (default: es)
#
# Si no se configuran, las notificaciones quedan desactivadas (sin error).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=culto_recordatorio
WHATSAPP_TEMPLATE_LANG=es
